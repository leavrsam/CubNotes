{
  "functions": {
    "src/app/api/**/*": {
      "maxDuration": 60
    },
    "app/api/**/*": {
      "maxDuration": 60
    },
    "api/**/*": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Motif.apk\""
        }
      ]
    }
  ]
}
